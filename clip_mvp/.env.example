# Copy this file to .env before running.
# Do not share your real .env because it contains API keys.

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=180
NARRATION_CHARS_PER_SECOND_MIN=3.2
NARRATION_CHARS_PER_SECOND_MAX=5.2

FUNASR_DEVICE=auto
FUNASR_MODEL=iic/speech_paraformer-large-vad-punc_asr_nat-zh-cn-16k-common-vocab8404-pytorch
FUNASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

TTS_PROVIDER=cosyvoice
TTS_DEFAULT_MODE=standard
TTS_STANDARD_PROVIDER=cosyvoice
TTS_CLONE_PROVIDER=cosyvoice
TTS_TIMEOUT_SECONDS=120
TTS_HTTP_READ_TIMEOUT_SECONDS=300
TTS_DEFAULT_VOICE=中文女
TTS_KEEP_ORIGINAL_AUDIO_DEFAULT=true
TTS_ORIGINAL_AUDIO_VOLUME=0.18
TTS_SPEED_DEFAULT=1.0
TTS_CHUNK_SOFT_CHARS=60
TTS_CHUNK_HARD_CHARS=90

# Default CosyVoice paths are resolved by the backend relative to this layout:
# FUNASR/
#   clip_mvp/
#   third_party/
#     cosyvoice-env-win/
#     CosyVoice/
#     models/Fun-CosyVoice3-0.5B/
# Override only if your paths are different.
# COSYVOICE_LOCAL_PYTHON=..\third_party\cosyvoice-env-win\python.exe
# COSYVOICE_REPO_DIR=..\third_party\CosyVoice
# COSYVOICE_MODEL_DIR=..\third_party\models\Fun-CosyVoice3-0.5B
# COSYVOICE_CACHE_DIR=..\third_party\hf_cache
COSYVOICE_BASE_URL=http://127.0.0.1:50000
COSYVOICE_SFT_ENDPOINT=/inference_sft
